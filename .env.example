# ---- Web search (Q&A "Search internet" + regulatory/knowledge scans) ----
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# ---- Web-search FALLBACK CHAIN (lib/searchProvider.js) ----
# Tavily used to be the only external dependency with no fallback: a quota or
# key problem silently broke the search box and Q&A web evidence. Search now
# walks a chain and fails down it, tripping a 5-minute circuit breaker on any
# provider that errors twice in a row.
#   tavily = primary, best quality       (needs TAVILY_API_KEY)
#   brave  = official API, free ~2k/mo   (needs BRAVE_API_KEY)
#   jina   = s.jina.ai, KEYLESS backstop (JINA_API_KEY only lifts rate limits)
# Unknown names are ignored, so a typo cannot take search offline.
# DuckDuckGo is deliberately absent: it was removed from this repo because
# Render's shared IP gets bot-challenged (see the header comment in server.js).
# WEB_SEARCH_CHAIN=tavily,brave,jina
# Brave Search API key — optional. When unset, Brave is skipped and the chain
# falls straight through to the keyless Jina leg. https://brave.com/search/api/
# BRAVE_API_KEY=

# ---- Proposed-changes resolver (the "Suggested Updates" new-info previews) ----
# Selects how a Google News item is turned into a real article preview.
#   jina  = Jina Reader. EXTRACTION (r.jina.ai) is KEYLESS and works from any IP.
#           RESOLUTION (s.jina.ai search) now REQUIRES JINA_API_KEY; without it,
#           the resolver falls back to the legacy DuckDuckGo/GDELT scraper
#           (works on Render's production IP, blocked from some sandbox IPs).
#   (any other value) = legacy DuckDuckGo/GDELT scraper only.
# Jina is the default.
SEARCH_PROVIDER=jina
# Required for Jina SEARCH resolution (s.jina.ai); optional for extraction.
# Get a free key at https://jina.ai — without it, resolution uses DDG/GDELT.
# JINA_API_KEY=

# ---- Build-time i18n pre-fill (scripts/i18n-prefill.cjs, PR #90) ----
# Translates NEW `en` UI strings into `zh-CN` when they are added without a
# hand-authored Chinese value. DeepL is primary; Google Translate is the
# fallback chain. If NEITHER key is set the pre-fill is a clean no-op (it only
# ever ADDS missing keys and never overwrites hand-authored zh-CN).
# Runtime only — never commit these. Set in the Render shell, not in git.
# DeepL Free API key ends in ":fx" (uses api-free.deepl.com); any other value is Pro.
# DEEPL_API_KEY=
# Google Translate API key (https://console.cloud.google.com — enable the
# "Cloud Translation API"). Only used as a DeepL fallback.
# GOOGLE_TRANSLATE_KEY=

# These same keys ALSO power the request-time KB / news translation cache
# (PR #91): shared datasets + news summaries are translated once, cached in
# Postgres (kb_translations / news_translations), and only re-translated when
# the source content hash changes. News translations are retained ONLY for
# articles the client flags as saved, purged at 180 days. Missing key = Chinese
# simply serves English (nothing cached). Maintenance endpoints (ADMIN_API_KEY):
#   POST /api/admin/purge-news-translations   (delete unsaved / >180d rows)
#   POST /api/admin/retranslate-kb            (clear cache → re-translate on next read)

# ---- Open-source AI model (Q&A "Use AI model") ----
# Any OpenAI-compatible chat-completions host. Groq by default.
# Groq:        https://console.groq.com  (free tier, fast, open-weight models)
# OpenRouter:  https://openrouter.ai      (set OPEN_MODEL_BASE_URL + a model slug)
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=https://api.groq.com/openai/v1
# Default model (no need to set): llama-3.1-8b-instant — Groq free tier gives it
# a 500K tokens/day cap (vs 100K for llama-3.3-70b), which the background
# enrichment + Q&A workload needs. Override for higher quality if you have quota.
OPEN_MODEL_NAME=llama-3.1-8b-instant

# Set to 1 to disable the AI model entirely (Q&A becomes extractive-only).
# SUMMARY_DISABLE_MODEL=1

# ---- Optional: separate key for the background "Suggested Updates" scan ----
# By default the scan reuses OPEN_MODEL_API_KEY. Set a DISTINCT key here
# (e.g. a second free-tier Groq account, or your paid plan's second key) so the
# background scan's usage is rate-limited/billed separately from interactive Q&A
# and can never exhaust Q&A's daily quota.
# OPEN_MODEL_API_KEY_SCAN=
# OPEN_MODEL_BASE_URL_SCAN=
# Per-lane model id for the scan lane. REQUIRED when the scan uses a different
# host than Q&A (e.g. Groq Q&A + OpenRouter scan): OpenRouter rejects Groq
# slugs, so set an OpenRouter id like meta-llama/llama-3.3-70b-instruct. Falls
# back to OPEN_MODEL_NAME when unset.
# OPEN_MODEL_NAME_SCAN=
# OPTIONAL dedicated credentials for the scan-lane FALLBACK candidate. Enables
# the "double-account" trick: run the scan primary on a 2nd Groq account
# (OPEN_MODEL_API_KEY_SCAN) and point its fallback at a DISTINCT account here, so
# two independent RPM/quota pools back the background scan. When unset, the
# fallback reuses the Q&A key/URL (current behaviour). The fallback is kept
# whenever it differs in MODEL or in CREDENTIAL from the primary — so a
# same-model-but-different-account fallback is preserved (not collapsed away).
# OPEN_MODEL_API_KEY_FALLBACK_SCAN=
# OPEN_MODEL_BASE_URL_FALLBACK_SCAN=
# Set to 1 to disable ONLY the scan's model (scan falls back to heuristics).
# SUMMARY_DISABLE_SCAN=1

# ---- Scan-lane pacing / daily quota (free-tier OpenRouter) ----
# These live in config.js and are the main knobs for staying under the free-tier
# ~50 req/day ceiling. Tune only if you change model hosts/tiers.
#
# Min spacing between two scan model calls (process-gLOBAL slot). 4000ms = 15
# calls/min, safely under the 20 RPM ceiling. Raise only if your host allows more.
# SCAN_MODEL_MIN_GAP_MS=4000
# Max model calls a single scan run may make. Unfinished proposals roll to the
# next run. Load-bearing because it is enforced in-process (the daily counter
# can reset on Render's ephemeral filesystem).
# SCAN_CALLS_PER_RUN_CAP=8
# Max scan model calls per UTC day. Persisted in source-state, rolls over at UTC
# midnight. 35 leaves headroom under the 50/day free-tier ceiling.
# SCAN_DAILY_CALL_BUDGET=35
# Retries per proposal when a single call 429s with a short Retry-After.
# SCAN_RETRY_CAP=3
# Short per-proposal backoff after a 429 (NOT the engine's full cooldown), so the
# next scan retries that proposal much sooner instead of waiting 20 min.
# SCAN_PROPOSAL_BACKOFF_MS=2700000   # 45 min

# ---- Scan scheduler ----
# How often the scan loop wakes (ms). 60 min (was 5 min): at 5 min the theoretical
# ceiling was thousands of calls/day against a 35/day allowance.
# SOURCE_SCAN_TICK_MS=3600000        # 60 min
# Skip the boot scan if the last scan was within this window (ms). Render's free
# tier spins the container down when idle, so every wake is a fresh process; this
# guard stops a restart shortly after a scan from repeating it.
# BOOT_SCAN_MIN_GAP_MS=3600000       # 60 min

# ---- News refresh scheduler (Thread B) ----
# How often the server proactively refreshes the default news feed (ms) so it
# stays live even with no visitors. Keyless RSS fan-out (no AI tokens).
# NEWS_CRON_MS=300000               # 5 min

# ---- Server ----
# PORT=3000

# ---- Optional admin auth (state-changing endpoints) ----
# When set, POST /api/proposed-changes/:id/integrate and .../dismiss require the
# request to carry the matching `X-Admin-Key` header (the frontend prompts for
# it once and remembers it in localStorage). UNSET = auth disabled (existing
# behaviour preserved). Use this if the app is exposed publicly.
# ADMIN_API_KEY=some-long-random-secret

# ---- Accounts v1: magic-link sign-in (locks the app behind verification) ----
# When AUTH_ENABLED is unset (default) the app stays fully public, exactly as
# before. Set AUTH_ENABLED=1 AND provide the three Supabase values below to lock
# the whole web app behind email verification (fixes public Render visibility).
# Supabase Auth sends the magic-link email, so no separate email service is
# needed. The anon key is PUBLIC by design — safe to expose to the browser.
# AUTH_ENABLED=1
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Comma-separated allow-list. Nobody else can request a link (no public signup).
# ALLOWED_EMAILS=you@company.com,colleague@company.com
# Comma-separated admins. Defaults to ALLOWED_EMAILS when unset. Admins can use
# the key-gated integrate/dismiss/admin endpoints via their session alone.
# ADMIN_EMAILS=you@company.com

